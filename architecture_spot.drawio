<mxfile>
  <diagram name="EKS Spot Architecture" id="spot-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Layer 1: AWS Region -->
        <mxCell id="region" value="AWS Region: ap-southeast-3" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1160" height="720" as="geometry"/>
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC 10.0.0.0/16" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=5;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="660" as="geometry"/>
        </mxCell>

        <!-- AZ-a -->
        <mxCell id="aza" value="AZ: ap-southeast-3a" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="340" height="600" as="geometry"/>
        </mxCell>

        <!-- AZ-b -->
        <mxCell id="azb" value="AZ: ap-southeast-3b" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="340" height="600" as="geometry"/>
        </mxCell>

        <!-- AZ-c -->
        <mxCell id="azc" value="AZ: ap-southeast-3c" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="340" height="600" as="geometry"/>
        </mxCell>

        <!-- EKS Cluster -->
        <mxCell id="eks" value="EKS Cluster: eks-spot-asg (v1.35)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="1040" height="540" as="geometry"/>
        </mxCell>

        <!-- System MNG -->
        <mxCell id="sys-mng" value="System MNG (ON_DEMAND)&#xa;taint: workload-type=system:NoSchedule" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;verticalAlign=top;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="sys-node1" value="System Node&#xa;m5.large&#xa;───────&#xa;CA | NTH&#xa;Kubecost" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="110" y="220" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sys-node2" value="System Node&#xa;m5.large&#xa;───────&#xa;Kubecost&#xa;Prometheus" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="130" height="90" as="geometry"/>
        </mxCell>

        <!-- On-Demand MNG -->
        <mxCell id="od-mng" value="Workload MNG — ON_DEMAND&#xa;(no taint)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;verticalAlign=top;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="500" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="od-node1" value="On-Demand Node&#xa;m5.large (3a)&#xa;───────&#xa;details-v1&#xa;reviews-v2, v3&#xa;istiod | CoreDNS" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="110" y="390" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="od-node2" value="On-Demand Node&#xa;m5.large (3b)&#xa;───────&#xa;productpage-v1&#xa;reviews-v1, v2" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="270" y="390" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="od-node3" value="On-Demand Node&#xa;m5.large (3c)&#xa;───────&#xa;productpage-v1&#xa;reviews-v3" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="430" y="390" width="140" height="100" as="geometry"/>
        </mxCell>

        <!-- Spot MNG -->
        <mxCell id="spot-mng" value="Workload MNG — SPOT (8 instance types)&#xa;taint: spot=true:NoSchedule" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;verticalAlign=top;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="500" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="spot-node1" value="⚡ Spot Node&#xa;m7i-flex.large (3a)&#xa;───────&#xa;ratings-v1&#xa;reviews-v1" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="110" y="560" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="spot-node2" value="⚡ Spot Node&#xa;m5.large (3c)&#xa;───────&#xa;details-v1&#xa;ratings-v1 | reviews-v1&#xa;locust" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- Event Flow -->
        <mxCell id="eb" value="EventBridge" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sqs" value="SQS Queue&#xa;(NTH)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eb2sqs" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="eb" target="sqs" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eb-label" value="Spot ITN&#xa;Rebalance&#xa;State Change&#xa;Health Events" style="text;fontSize=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="190" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- Interruption flow arrow -->
        <mxCell id="sqs2nth" value="cordon + drain" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;" edge="1" source="sqs" target="sys-node1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CA + HPA -->
        <mxCell id="ca-box" value="Cluster Autoscaler&#xa;Priority: Spot &gt; On-Demand" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hpa-box" value="HPA (CPU 70%)&#xa;min=2, max=10" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="380" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hpa2ca" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;" edge="1" source="hpa-box" target="ca-box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ca2spot" value="scale up" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;" edge="1" source="ca-box" target="spot-mng" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Observability -->
        <mxCell id="obs" value="Observability&#xa;─────────&#xa;Kubecost (Spot Checklist)&#xa;Kiali (Service Mesh)&#xa;Istio (Sidecar Injection)&#xa;Locust (Load Test)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="320" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- Placement Legend -->
        <mxCell id="legend" value="Placement Strategies&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;productpage → nodeSelector: ON_DEMAND&#xa;details → prefer Spot 70/30 + spread capacityType&#xa;ratings → require SPOT + spread instanceType&#xa;reviews → prefer Spot weight 90 (soft)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="250" height="100" as="geometry"/>
        </mxCell>

        <!-- Spot Interruption Flow Legend -->
        <mxCell id="flow-legend" value="Spot Interruption Flow&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;1. EC2 sends ITN event&#xa;2. EventBridge → SQS&#xa;3. NTH cordons + drains node&#xa;4. Pods reschedule (PDB respected)&#xa;5. ASG launches replacement&#xa;6. CA rebalances across AZs" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="560" width="250" height="110" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
